{
  "name": "@weiban/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "微伴接口与事件契约（唯一准绳）。Zod 4 schema 为源头，导出 TypeScript 类型与 JSON Schema。",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "tsx scripts/generate-json-schema.ts"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  }
}
