# 香港服务器（仅 IP）公共运行配置；复制到 /srv/weiban/runtime.env。秘密值不放这里。
SECRETS_DIR=/srv/weiban/secrets
WEB_HOST=103.231.58.124
# 下面三项由 deploy/hk/compose.override.yml 覆盖为 :80 / :8081，此处仅满足 compose.yml 的必填检查。
WEB_DOMAIN=:80
ADMIN_DOMAIN=:8081
# 后台经 SSH 隧道在总经理电脑上的地址（本地端口 9081）。
ADMIN_PUBLIC_ORIGIN=http://localhost:9081
BILLING_PLATFORM_DAILY_CAP_MICROS=20000000
PLATFORM_KEK_VERSION=1
APP_IMAGE=weiban-app:hk
EDGE_IMAGE=weiban-edge:hk
