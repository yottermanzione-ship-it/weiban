# 双域名 HTTPS 的公开配置片段。合并进现有 /srv/weiban/runtime.env，不能整文件覆盖原配置。
# 保留原 APP_IMAGE / EDGE_IMAGE、成本上限、密钥路径和其它业务开关。
# 域名均由总经理控制；app/admin A 记录指向 103.231.58.124。
WEB_HOST=app.weiban.online
WEB_DOMAIN="app.weiban.online, http://103.231.58.124"
ADMIN_DOMAIN="admin.weiban.online, :8081"
ADMIN_PUBLIC_ORIGIN=https://admin.weiban.online
MEDIA_PUBLIC_BASE_URL=https://app.weiban.online

# 上面显式保留旧 HTTP IP 入口，兼容尚未更新的客户端；8081仍只绑定服务器回环。
# 80用于HTTP跳转/ACME，443提供HTTPS；应用3000和数据库5432不发布公网。
# 不修改旧根域/weiban.online、www或旧站，不迁账号/聊天/外部绑定。
