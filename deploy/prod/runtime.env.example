# 公共运行配置；秘密值写入SECRETS_DIR内三个文件，不放在这里。
# 复制到服务器目录（仓库外），通过docker compose --env-file加载。
SECRETS_DIR=/srv/weiban/secrets
WEB_HOST=weiban.example.com
WEB_DOMAIN=weiban.example.com
ADMIN_DOMAIN=admin.weiban.example.com
BILLING_PLATFORM_DAILY_CAP_MICROS=20000000
PLATFORM_KEK_VERSION=1
APP_IMAGE=weiban-app:local
EDGE_IMAGE=weiban-edge:local
