<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- T-075 语音通话：全屏来电、通话前台服务（麦克风类型）。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application>
        <meta-data android:name="firebase_messaging_installation_id_enabled" android:value="true" />
        <meta-data android:name="firebase_messaging_notification_delegation_enabled" android:value="false" />
        <service android:name="com.google.firebase.messaging.FirebaseMessagingService" tools:node="remove" />
        <service android:name="app.weiban.platform.WeibanMessagingService" android:exported="false" android:directBootAware="false">
            <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT" /></intent-filter>
        </service>
        <provider android:name="com.google.firebase.provider.FirebaseInitProvider" tools:node="remove" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_messaging_delivery_metrics_exported_to_big_query_enabled" android:value="false" />
        <service android:name="app.weiban.platform.CallForegroundService" android:exported="false" android:foregroundServiceType="microphone" />
        <receiver android:name="app.weiban.platform.CallActionReceiver" android:exported="false" />
    </application>
</manifest>
