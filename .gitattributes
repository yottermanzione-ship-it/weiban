# 统一换行符：仓库里一律存 LF，Windows 本机检出时自动转换
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.jar binary
*.keystore binary
