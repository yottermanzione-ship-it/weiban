{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "微伴设计令牌 v2.0（T-012，design-lead，2026-10-04）。本文件是所有设计数值的唯一来源。tokens.css（网页）和安卓 Kotlin 常量都由 scripts/build-tokens.mjs（仓库根目录）从本文件生成，不手抄。格式参考 W3C Design Tokens 草案：$value 为值，$type 为类型，{a.b.c} 为引用。颜色分三层：primitive（原始色板，组件不直接用）→ theme（随「主题 × 深浅模式」变化的五组颜色：bg、text、border、brand、bubble）→ semantic（只随深浅模式变化、不随主题变化的颜色）。share 组是分享图专用的固定颜色，不随主题和深浅模式变化。",
  "meta": {
    "version": "2.0.0",
    "prefix": "wb",
    "themes": {
      "$description": "主题列表。id 给代码用，name 是界面显示名。默认主题为 green（接近微信的白 / 浅灰底 + 绿色强调，PRD SVC-01 第 7 条）。界面文字里不出现「微信」二字。",
      "green": { "name": "默认", "default": true },
      "pink":  { "name": "微伴粉", "default": false }
    },
    "modes": ["light", "dark"],
    "cssNaming": "层级用短横线连接，驼峰转短横线，加前缀 --wb-。theme.<主题>.<模式>.color.bg.page 与 semantic.<模式>.color.status.success 都去掉主题和模式两级，变成 --wb-color-bg-page、--wb-color-status-success（同一个变量名，值随主题和模式切换）。其余如 space.4 → --wb-space-4，share.logo → --wb-share-logo。",
    "htmlAttributes": "主题：<html data-theme=\"green|pink\">，不写等于 green。深浅模式：<html data-scheme=\"light|dark\">，不写等于跟随系统。"
  },

  "primitive": {
    "color": {
      "pink": {
        "50":  { "$value": "#FFF4F7", "$type": "color" },
        "100": { "$value": "#FFE6EE", "$type": "color" },
        "200": { "$value": "#FFD3E1", "$type": "color" },
        "300": { "$value": "#FFB3CA", "$type": "color" },
        "400": { "$value": "#F784A8", "$type": "color" },
        "500": { "$value": "#E0457B", "$type": "color", "$description": "微伴粉，品牌色与 logo 色。白字对比度 3.96:1（满足大字和界面元素 3:1）" },
        "600": { "$value": "#C7346A", "$type": "color" },
        "700": { "$value": "#A32457", "$type": "color" },
        "750": { "$value": "#8A3358", "$type": "color", "$description": "微伴粉主题深色模式自己的气泡底色" },
        "800": { "$value": "#7A1C43", "$type": "color" },
        "900": { "$value": "#4F1430", "$type": "color" }
      },
      "jade": {
        "$description": "默认主题的绿色强调色。刻意与参照产品的品牌绿不同（更深一点），白字对比度更高",
        "50":  { "$value": "#E8F7EF", "$type": "color" },
        "300": { "$value": "#5FD39A", "$type": "color" },
        "400": { "$value": "#3CC783", "$type": "color" },
        "500": { "$value": "#0AA35A", "$type": "color", "$description": "默认主题主色。白字对比度 3.28:1（满足大字和界面元素 3:1）" },
        "600": { "$value": "#088F4D", "$type": "color" },
        "700": { "$value": "#0A7A43", "$type": "color", "$description": "浅绿底上的绿字，对比度 4.9:1" },
        "750": { "$value": "#3BAA6A", "$type": "color", "$description": "默认主题深色模式自己的气泡底色（配深色字 5.9:1）" }
      },
      "lime": {
        "300": { "$value": "#A0E37C", "$type": "color", "$description": "默认主题浅色模式自己的气泡底色（配墨色字 11.4:1）" }
      },
      "lilac": {
        "100": { "$value": "#F1EBFF", "$type": "color" },
        "300": { "$value": "#C9B5F5", "$type": "color" },
        "500": { "$value": "#8F72D9", "$type": "color", "$description": "辅助色：薰衣草紫" },
        "700": { "$value": "#5E44A8", "$type": "color" }
      },
      "neutral": {
        "$description": "暖灰（带一点粉），微伴粉主题使用",
        "0":    { "$value": "#FFFFFF", "$type": "color" },
        "25":   { "$value": "#FBF9FA", "$type": "color" },
        "50":   { "$value": "#F6F3F5", "$type": "color" },
        "100":  { "$value": "#EEEAEC", "$type": "color" },
        "200":  { "$value": "#E2DDE0", "$type": "color" },
        "300":  { "$value": "#CBC5C9", "$type": "color" },
        "400":  { "$value": "#A8A1A6", "$type": "color" },
        "500":  { "$value": "#857E83", "$type": "color" },
        "600":  { "$value": "#655F63", "$type": "color" },
        "700":  { "$value": "#4A4448", "$type": "color" },
        "800":  { "$value": "#2E2A2D", "$type": "color" },
        "850":  { "$value": "#262329", "$type": "color" },
        "900":  { "$value": "#1C1A1E", "$type": "color" },
        "950":  { "$value": "#121013", "$type": "color" },
        "1000": { "$value": "#0B0A0C", "$type": "color" },
        "ink":  { "$value": "#1F1A1D", "$type": "color" },
        "mist": { "$value": "#EDE8EC", "$type": "color" }
      },
      "gray": {
        "$description": "纯中性灰，默认主题使用",
        "0":   { "$value": "#FFFFFF", "$type": "color" },
        "25":  { "$value": "#F7F7F7", "$type": "color" },
        "50":  { "$value": "#F2F2F2", "$type": "color" },
        "100": { "$value": "#EDEDED", "$type": "color" },
        "150": { "$value": "#E5E5E5", "$type": "color" },
