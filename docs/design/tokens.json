  "typography": {
    "fontFamily": {
      "sans":  { "$value": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"HarmonyOS Sans SC\", \"MiSans\", \"Noto Sans SC\", \"Source Han Sans SC\", \"Microsoft YaHei\", \"Helvetica Neue\", Arial, sans-serif", "$type": "fontFamily", "$description": "全部界面文字。只用系统字体，不下载中文网络字体（体积大、首屏慢）" },
      "serif": { "$value": "\"Songti SC\", \"Noto Serif SC\", \"Source Han Serif SC\", \"STSong\", \"SimSun\", serif", "$type": "fontFamily", "$description": "只用于卡片风分享图、卡面上「角色写给你的一句话」" },
      "numeric": { "$value": "\"SF Pro Rounded\", -apple-system, \"HarmonyOS Sans SC\", \"MiSans\", \"Roboto\", sans-serif", "$type": "fontFamily", "$description": "大号数字：认识第 N 天、卡片编号、熟悉度点数。配合 font-variant-numeric: tabular-nums" }
    },
    "fontSize": {
      "$description": "单位 px，均乘以 --wb-font-scale（用户在设置里调字体大小：0.9 / 1 / 1.1 / 1.2 / 1.35）",
      "caption2": { "$value": "11px", "$type": "dimension", "$description": "角标、标签栏文字" },
      "caption1": { "$value": "12px", "$type": "dimension", "$description": "时间、已读、系统提示" },
