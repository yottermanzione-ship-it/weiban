          "elevated":      { "$value": "{primitive.color.neutral.850}",  "$type": "color" },
          "inputField":    { "$value": "{primitive.color.neutral.850}",  "$type": "color" },
          "inputBar":      { "$value": "{primitive.color.neutral.900}",  "$type": "color" },
          "navBar":        { "$value": "{primitive.color.neutral.1000}", "$type": "color" },
          "tabBar":        { "$value": "{primitive.color.neutral.900}",  "$type": "color" },
          "scrim":         { "$value": "rgba(0, 0, 0, 0.60)",            "$type": "color" },
          "pressed":       { "$value": "rgba(255, 255, 255, 0.08)",      "$type": "color" },
          "skeleton":      { "$value": "{primitive.color.neutral.850}",  "$type": "color" }
        },
        "text": {
          "primary":     { "$value": "{primitive.color.neutral.mist}", "$type": "color" },
          "secondary":   { "$value": "{primitive.color.neutral.400}",  "$type": "color" },
          "tertiary":    { "$value": "{primitive.color.neutral.500}",  "$type": "color" },
          "placeholder": { "$value": "{primitive.color.neutral.600}",  "$type": "color" },
          "onBrand":     { "$value": "#FFFFFF",                        "$type": "color" },
