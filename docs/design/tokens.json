          "memorial":    { "$value": "{primitive.color.pink.400}",   "$type": "color" },
          "familiarity": { "$value": "{primitive.color.lilac.300}",  "$type": "color" },
          "festival":    { "$value": "{primitive.color.orange.300}", "$type": "color" },
          "moment":      { "$value": "{primitive.color.blue.400}",   "$type": "color" },
          "silhouette":  { "$value": "{primitive.color.neutral.800}", "$type": "color" }
        },
        "mode": {
          "tsundere":   { "$value": "{primitive.color.orange.300}", "$type": "color" },
          "romance":    { "$value": "{primitive.color.pink.400}",   "$type": "color" },
          "adult":      { "$value": "{primitive.color.neutral.400}", "$type": "color" },
