        },
        "badge": {
          "unread":   { "$value": "{primitive.color.red.500}", "$type": "color", "$description": "未读数用红色，与微信一致，保证识别度" },
          "onUnread": { "$value": "#FFFFFF", "$type": "color" },
          "muted":    { "$value": "{primitive.color.neutral.300}", "$type": "color", "$description": "免打扰会话的灰点" }
        },
        "familiarity": {
          "l1": { "$value": "{primitive.color.neutral.400}", "$type": "color", "$description": "L1 初识" },
          "l2": { "$value": "{primitive.color.pink.400}",    "$type": "color", "$description": "L2 眼熟" },
          "l3": { "$value": "{primitive.color.pink.500}",    "$type": "color", "$description": "L3 熟络" },
          "l4": { "$value": "{primitive.color.lilac.500}",   "$type": "color", "$description": "L4 老友" },
          "l5": { "$value": "{primitive.color.gold.500}",    "$type": "color", "$description": "L5 知己" },
          "track": { "$value": "{primitive.color.neutral.100}", "$type": "color" }
        },
        "card": {
          "memorial":    { "$value": "{primitive.color.pink.500}",   "$type": "color", "$description": "纪念卡" },
          "familiarity": { "$value": "{primitive.color.lilac.500}",  "$type": "color", "$description": "熟悉度卡" },
          "festival":    { "$value": "{primitive.color.orange.500}", "$type": "color", "$description": "节日卡" },
          "moment":      { "$value": "{primitive.color.blue.500}",   "$type": "color", "$description": "瞬间卡" },
          "silhouette":  { "$value": "{primitive.color.neutral.200}", "$type": "color", "$description": "未获得卡片的剪影" }
        },
        "mode": {
