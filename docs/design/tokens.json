      "light": {
        "color": {
          "bg": {
            "page":          { "$value": "{primitive.color.gray.100}", "$type": "color", "$description": "一级页面背景、分组列表背景" },
            "chat":          { "$value": "{primitive.color.gray.100}", "$type": "color", "$description": "聊天区背景" },
            "surface":       { "$value": "{primitive.color.gray.0}",   "$type": "color", "$description": "列表行、卡片" },
            "surfacePinned": { "$value": "{primitive.color.gray.25}",  "$type": "color", "$description": "置顶会话行底色" },
            "elevated":      { "$value": "{primitive.color.gray.0}",   "$type": "color", "$description": "弹层、菜单、对话框" },
