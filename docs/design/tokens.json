        "850": { "$value": "#232323", "$type": "color" },
        "900": { "$value": "#191919", "$type": "color" },
        "950": { "$value": "#111111", "$type": "color" },
        "ink": { "$value": "#1A1A1A", "$type": "color" },
        "mist": { "$value": "#E6E6E6", "$type": "color" }
