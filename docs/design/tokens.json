            "inputBar":      { "$value": "{primitive.color.gray.25}",  "$type": "color" },
            "navBar":        { "$value": "{primitive.color.gray.100}", "$type": "color" },
            "tabBar":        { "$value": "{primitive.color.gray.25}",  "$type": "color" },
            "scrim":         { "$value": "rgba(0, 0, 0, 0.50)",        "$type": "color", "$description": "弹层背后的遮罩" },
            "pressed":       { "$value": "rgba(0, 0, 0, 0.05)",        "$type": "color", "$description": "按下态叠加层" },
            "skeleton":      { "$value": "{primitive.color.gray.150}", "$type": "color" }
          },
          "text": {
            "primary":       { "$value": "{primitive.color.gray.ink}", "$type": "color" },
            "secondary":     { "$value": "{primitive.color.gray.600}", "$type": "color", "$description": "白底 5.3:1" },
            "tertiary":      { "$value": "{primitive.color.gray.500}", "$type": "color", "$description": "仅用于时间、辅助说明" },
            "placeholder":   { "$value": "{primitive.color.gray.400}", "$type": "color" },
            "onBrand":       { "$value": "#FFFFFF",                    "$type": "color" },
            "link":          { "$value": "#4F6592",                    "$type": "color", "$description": "链接、可点的人名，蓝灰色，白底 5.8:1" },
            "nameInMoments": { "$value": "#4F6592",                    "$type": "color", "$description": "朋友圈、群聊、点赞评论中的人名" },
