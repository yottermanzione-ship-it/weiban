      "red":    { "100": { "$value": "#FDE7E7", "$type": "color" }, "400": { "$value": "#FF6B6B", "$type": "color" }, "500": { "$value": "#F04848", "$type": "color" } },
      "orange": { "100": { "$value": "#FDF0E1", "$type": "color" }, "300": { "$value": "#F5B36B", "$type": "color" }, "500": { "$value": "#E8892B", "$type": "color" }, "700": { "$value": "#8A4B0F", "$type": "color" } },
      "green":  { "100": { "$value": "#E2F5EC", "$type": "color" }, "400": { "$value": "#4CC38A", "$type": "color" }, "500": { "$value": "#2BA471", "$type": "color" } },
      "blue":   { "100": { "$value": "#E6F0FD", "$type": "color" }, "400": { "$value": "#6FA3F0", "$type": "color" }, "500": { "$value": "#3B7FE0", "$type": "color" } },
      "gold":   { "100": { "$value": "#FBF1DC", "$type": "color" }, "500": { "$value": "#D9A23A", "$type": "color" }, "700": { "$value": "#8C6418", "$type": "color" } },

