          "danger":      { "$value": "{primitive.color.red.400}",      "$type": "color" }
        },
        "border": {
          "hairline": { "$value": "rgba(255, 255, 255, 0.10)", "$type": "color" },
          "strong":   { "$value": "{primitive.color.neutral.700}", "$type": "color" },
          "focus":    { "$value": "{primitive.color.pink.400}", "$type": "color" }
        },
        "brand": {
          "primary":        { "$value": "{primitive.color.pink.500}", "$type": "color" },
          "primaryPressed": { "$value": "{primitive.color.pink.600}", "$type": "color" },
          "soft":           { "$value": "rgba(224, 69, 123, 0.18)",   "$type": "color" },
          "onSoft":         { "$value": "{primitive.color.pink.300}", "$type": "color" },
          "accent":         { "$value": "{primitive.color.lilac.300}", "$type": "color" }
        },
        "bubble": {
          "selfBg":     { "$value": "{primitive.color.pink.750}", "$type": "color" },
          "selfText":   { "$value": "#FFFFFF", "$type": "color" },
          "otherBg":    { "$value": "{primitive.color.neutral.850}", "$type": "color" },
          "otherText":  { "$value": "{primitive.color.neutral.mist}", "$type": "color" },
          "quoteBg":    { "$value": "rgba(255, 255, 255, 0.06)", "$type": "color" },
          "quoteText":  { "$value": "{primitive.color.neutral.400}", "$type": "color" },
          "voiceWave":  { "$value": "{primitive.color.neutral.mist}", "$type": "color" }
        },
        "status": {
          "success":     { "$value": "{primitive.color.green.400}", "$type": "color" },
          "successSoft": { "$value": "rgba(43, 164, 113, 0.18)", "$type": "color" },
          "warning":     { "$value": "{primitive.color.orange.300}", "$type": "color" },
          "warningSoft": { "$value": "rgba(232, 137, 43, 0.16)", "$type": "color" },
          "warningText": { "$value": "{primitive.color.orange.300}", "$type": "color" },
          "danger":      { "$value": "{primitive.color.red.400}", "$type": "color" },
          "dangerSoft":  { "$value": "rgba(240, 72, 72, 0.18)", "$type": "color" },
          "info":        { "$value": "{primitive.color.blue.400}", "$type": "color" },
          "infoSoft":    { "$value": "rgba(59, 127, 224, 0.18)", "$type": "color" }
        },
        "badge": {
          "unread":   { "$value": "{primitive.color.red.500}", "$type": "color" },
          "onUnread": { "$value": "#FFFFFF", "$type": "color" },
          "muted":    { "$value": "{primitive.color.neutral.600}", "$type": "color" }
        },
        "familiarity": {
          "l1": { "$value": "{primitive.color.neutral.500}", "$type": "color" },
          "l2": { "$value": "{primitive.color.pink.300}",    "$type": "color" },
          "l3": { "$value": "{primitive.color.pink.400}",    "$type": "color" },
          "l4": { "$value": "{primitive.color.lilac.300}",   "$type": "color" },
          "l5": { "$value": "{primitive.color.gold.500}",    "$type": "color" },
          "track": { "$value": "{primitive.color.neutral.800}", "$type": "color" }
        },
