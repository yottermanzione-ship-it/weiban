          "romance":    { "$value": "{primitive.color.pink.500}",   "$type": "color", "$description": "恋爱" },
          "adult":      { "$value": "{primitive.color.neutral.600}", "$type": "color", "$description": "成人：刻意用低调中性色" },
          "custom":     { "$value": "{primitive.color.lilac.500}",  "$type": "color", "$description": "管理员新增的模式" }
