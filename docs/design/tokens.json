          "bgBottom": { "$value": "#120C10", "$type": "color" },
          "text":     { "$value": "#FFFFFF", "$type": "color" },
          "textSecondary": { "$value": "rgba(255, 255, 255, 0.68)", "$type": "color" },
          "accept":   { "$value": "{primitive.color.green.500}", "$type": "color" },
          "decline":  { "$value": "{primitive.color.red.500}", "$type": "color" },
