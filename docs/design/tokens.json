{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "微伴设计令牌 v1.0（T-006，design-lead，2026-10-04）。本文件是所有设计数值的唯一来源；tokens.css 是它的 CSS 版本，两者必须同步，冲突时以本文件为准。格式参考 W3C Design Tokens 草案：$value 为值，$type 为类型，{a.b.c} 为引用。primitive 是原始色板，组件和页面只能使用 semantic 及其他分组的令牌，不直接用 primitive。",
  "meta": {
    "version": "1.0.0",
    "prefix": "wb",
    "cssNaming": "层级用短横线连接，驼峰转短横线，加前缀 --wb-。例：semantic.light.color.text.primary → --wb-color-text-primary（深浅模式共用同一个变量名，值随模式切换）；space.4 → --wb-space-4"
  },

  "primitive": {
    "color": {
      "pink": {
        "50":  { "$value": "#FFF4F7", "$type": "color" },
        "100": { "$value": "#FFE6EE", "$type": "color" },
        "200": { "$value": "#FFD3E1", "$type": "color" },
        "300": { "$value": "#FFB3CA", "$type": "color" },
        "400": { "$value": "#F784A8", "$type": "color" },
        "500": { "$value": "#E0457B", "$type": "color", "$description": "微伴粉，品牌主色。白字对比度 4.9:1" },
        "600": { "$value": "#C7346A", "$type": "color" },
        "700": { "$value": "#A32457", "$type": "color" },
        "750": { "$value": "#8A3358", "$type": "color", "$description": "深色模式自己的气泡底色" },
        "800": { "$value": "#7A1C43", "$type": "color" },
        "900": { "$value": "#4F1430", "$type": "color" }
      },
      "lilac": {
        "100": { "$value": "#F1EBFF", "$type": "color" },
        "300": { "$value": "#C9B5F5", "$type": "color" },
        "500": { "$value": "#8F72D9", "$type": "color", "$description": "辅助色：薰衣草紫，用于熟悉度高等级、瞬间卡" },
        "700": { "$value": "#5E44A8", "$type": "color" }
      },
      "neutral": {
        "0":    { "$value": "#FFFFFF", "$type": "color" },
        "25":   { "$value": "#FBF9FA", "$type": "color" },
        "50":   { "$value": "#F6F3F5", "$type": "color" },
        "100":  { "$value": "#EEEAEC", "$type": "color" },
        "200":  { "$value": "#E2DDE0", "$type": "color" },
        "300":  { "$value": "#CBC5C9", "$type": "color" },
        "400":  { "$value": "#A8A1A6", "$type": "color" },
        "500":  { "$value": "#857E83", "$type": "color" },
        "600":  { "$value": "#655F63", "$type": "color" },
        "700":  { "$value": "#4A4448", "$type": "color" },
        "800":  { "$value": "#2E2A2D", "$type": "color" },
        "850":  { "$value": "#262329", "$type": "color" },
        "900":  { "$value": "#1C1A1E", "$type": "color" },
        "950":  { "$value": "#121013", "$type": "color" },
        "1000": { "$value": "#0B0A0C", "$type": "color" },
        "ink":  { "$value": "#1F1A1D", "$type": "color", "$description": "正文墨色，带一点暖粉的近黑" },
        "mist": { "$value": "#EDE8EC", "$type": "color", "$description": "深色模式正文色" }
      },
      "red":    { "500": { "$value": "#F04848", "$type": "color" }, "100": { "$value": "#FDE7E7", "$type": "color" }, "400": { "$value": "#FF6B6B", "$type": "color" } },
      "orange": { "500": { "$value": "#E8892B", "$type": "color" }, "100": { "$value": "#FDF0E1", "$type": "color" }, "700": { "$value": "#8A4B0F", "$type": "color" }, "300": { "$value": "#F5B36B", "$type": "color" } },
      "green":  { "500": { "$value": "#2BA471", "$type": "color" }, "100": { "$value": "#E2F5EC", "$type": "color" }, "400": { "$value": "#4CC38A", "$type": "color" } },
      "blue":   { "500": { "$value": "#3B7FE0", "$type": "color" }, "100": { "$value": "#E6F0FD", "$type": "color" }, "400": { "$value": "#6FA3F0", "$type": "color" } },
      "gold":   { "500": { "$value": "#D9A23A", "$type": "color" }, "100": { "$value": "#FBF1DC", "$type": "color" }, "700": { "$value": "#8C6418", "$type": "color" } },

      "support": {
        "$description": "应援色预设盘：角色没有官方应援色时，按角色 ID 稳定地取其中一个。on 为盘上文字色（已按对比度预先算好）。用法见 default-avatar.md",
        "01": { "name": "樱粉",   "bg": { "$value": "#E8608C", "$type": "color" }, "on": { "$value": "#FFFFFF", "$type": "color" } },
        "02": { "name": "珊瑚",   "bg": { "$value": "#E8664A", "$type": "color" }, "on": { "$value": "#FFFFFF", "$type": "color" } },
        "03": { "name": "橘子",   "bg": { "$value": "#E0892B", "$type": "color" }, "on": { "$value": "#1F1A1D", "$type": "color" } },
        "04": { "name": "柠檬",   "bg": { "$value": "#D9B226", "$type": "color" }, "on": { "$value": "#1F1A1D", "$type": "color" } },
        "05": { "name": "抹茶",   "bg": { "$value": "#6FAE45", "$type": "color" }, "on": { "$value": "#1F1A1D", "$type": "color" } },
        "06": { "name": "薄荷",   "bg": { "$value": "#2EAA8A", "$type": "color" }, "on": { "$value": "#1F1A1D", "$type": "color" } },
        "07": { "name": "湖蓝",   "bg": { "$value": "#2F97CF", "$type": "color" }, "on": { "$value": "#FFFFFF", "$type": "color" } },
        "08": { "name": "海军",   "bg": { "$value": "#3F5FC4", "$type": "color" }, "on": { "$value": "#FFFFFF", "$type": "color" } },
        "09": { "name": "薰衣草", "bg": { "$value": "#8F72D9", "$type": "color" }, "on": { "$value": "#FFFFFF", "$type": "color" } },
        "10": { "name": "葡萄",   "bg": { "$value": "#A548BA", "$type": "color" }, "on": { "$value": "#FFFFFF", "$type": "color" } },
        "11": { "name": "玫瑰",   "bg": { "$value": "#CF3D66", "$type": "color" }, "on": { "$value": "#FFFFFF", "$type": "color" } },
        "12": { "name": "可可",   "bg": { "$value": "#8E6A58", "$type": "color" }, "on": { "$value": "#FFFFFF", "$type": "color" } }
      }
    }
  },

  "semantic": {
    "light": {
      "color": {
        "bg": {
          "page":          { "$value": "{primitive.color.neutral.50}",  "$type": "color", "$description": "一级页面背景、分组列表背景" },
          "chat":          { "$value": "#F7F2F4",                       "$type": "color", "$description": "聊天区背景，带极淡暖粉" },
          "surface":       { "$value": "{primitive.color.neutral.0}",   "$type": "color", "$description": "列表行、卡片" },
          "surfacePinned": { "$value": "{primitive.color.neutral.25}",  "$type": "color", "$description": "置顶会话行底色" },
          "elevated":      { "$value": "{primitive.color.neutral.0}",   "$type": "color", "$description": "弹层、菜单、对话框" },
          "inputField":    { "$value": "{primitive.color.neutral.0}",   "$type": "color" },
          "inputBar":      { "$value": "{primitive.color.neutral.50}",  "$type": "color" },
          "navBar":        { "$value": "{primitive.color.neutral.50}",  "$type": "color" },
          "tabBar":        { "$value": "{primitive.color.neutral.25}",  "$type": "color" },
          "scrim":         { "$value": "rgba(20, 12, 16, 0.45)",        "$type": "color", "$description": "弹层背后的遮罩" },
          "pressed":       { "$value": "rgba(31, 26, 29, 0.06)",        "$type": "color", "$description": "按下态叠加层" },
          "skeleton":      { "$value": "{primitive.color.neutral.100}", "$type": "color" }
        },
        "text": {
          "primary":     { "$value": "{primitive.color.neutral.ink}", "$type": "color" },
          "secondary":   { "$value": "{primitive.color.neutral.600}", "$type": "color", "$description": "白底对比度 6.3:1" },
          "tertiary":    { "$value": "{primitive.color.neutral.500}", "$type": "color", "$description": "仅用于时间、辅助说明等非关键信息" },
          "placeholder": { "$value": "{primitive.color.neutral.400}", "$type": "color" },
          "onBrand":     { "$value": "#FFFFFF",                       "$type": "color" },
          "link":        { "$value": "{primitive.color.pink.700}",    "$type": "color" },
          "nameInMoments": { "$value": "#4E5F8C",                     "$type": "color", "$description": "朋友圈、群聊中的人名色（对应微信的蓝紫色人名）" },
          "danger":      { "$value": "{primitive.color.red.500}",     "$type": "color" }
        },
        "border": {
          "hairline": { "$value": "rgba(31, 26, 29, 0.10)", "$type": "color", "$description": "0.5px 分隔线" },
          "strong":   { "$value": "{primitive.color.neutral.200}", "$type": "color" },
          "focus":    { "$value": "{primitive.color.pink.500}", "$type": "color" }
        },
        "brand": {
          "primary":        { "$value": "{primitive.color.pink.500}", "$type": "color" },
          "primaryPressed": { "$value": "{primitive.color.pink.600}", "$type": "color" },
          "soft":           { "$value": "{primitive.color.pink.100}", "$type": "color", "$description": "浅粉底，用于选中、标签" },
          "onSoft":         { "$value": "{primitive.color.pink.700}", "$type": "color" },
          "accent":         { "$value": "{primitive.color.lilac.500}", "$type": "color" }
        },
        "bubble": {
          "selfBg":     { "$value": "#FFD6E3", "$type": "color", "$description": "自己的气泡（对应微信的浅绿）" },
          "selfText":   { "$value": "{primitive.color.neutral.ink}", "$type": "color" },
          "otherBg":    { "$value": "{primitive.color.neutral.0}", "$type": "color" },
          "otherText":  { "$value": "{primitive.color.neutral.ink}", "$type": "color" },
          "quoteBg":    { "$value": "rgba(31, 26, 29, 0.05)", "$type": "color", "$description": "引用块底色" },
          "quoteText":  { "$value": "{primitive.color.neutral.600}", "$type": "color" },
          "voiceWave":  { "$value": "{primitive.color.neutral.ink}", "$type": "color" }
        },
        "status": {
          "success":     { "$value": "{primitive.color.green.500}", "$type": "color" },
          "successSoft": { "$value": "{primitive.color.green.100}", "$type": "color" },
          "warning":     { "$value": "{primitive.color.orange.500}", "$type": "color" },
          "warningSoft": { "$value": "{primitive.color.orange.100}", "$type": "color" },
          "warningText": { "$value": "{primitive.color.orange.700}", "$type": "color" },
          "danger":      { "$value": "{primitive.color.red.500}", "$type": "color" },
          "dangerSoft":  { "$value": "{primitive.color.red.100}", "$type": "color" },
          "info":        { "$value": "{primitive.color.blue.500}", "$type": "color" },
